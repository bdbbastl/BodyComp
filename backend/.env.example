# Kopieren nach .env, um Defaults aus app/core/config.py zu überschreiben.
# BODYCOMP_DATA_DIR=C:\path\to\other\data\dir

# Startpasswort für den einmalig migrierten Coach-Account (siehe
# app/core/migrate_to_multitenancy.py) - wird nur beim allerersten Start
# ohne bestehende User verwendet.
BODYCOMP_MIGRATION_SEED_PASSWORD=change-me

# Für die KI-gestützte Bildbewertung auf der Compare-Seite (Judge-Analyse).
# Kostenlosen Key unter https://aistudio.google.com/apikey erstellen
# (kein Kreditkarte nötig, großzügige Free-Tier-Limits). Ohne diesen Key
# funktioniert die App normal weiter, nur der "KI-Analyse"-Button auf der
# Compare-Seite meldet einen Fehler.
GEMINI_API_KEY=...

# Google OAuth Login (siehe app/routers/auth.py). Client-ID/Secret
# in der Google Cloud Console unter "APIs & Services > Credentials" anlegen.
BODYCOMP_GOOGLE_CLIENT_ID=change-me
BODYCOMP_GOOGLE_CLIENT_SECRET=change-me
BODYCOMP_GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Signiert Session-Cookies UND E-Mail-Verifizierungs-/Passwort-Reset-Tokens
# (siehe app/services/auth.py, app/core/config.py). MUSS in Produktion auf
# einen zufälligen, geheimen Wert gesetzt werden - der Default in
# config.py ist nur fürs lokale Dev-Setup gedacht und unsicher.
BODYCOMP_SESSION_SECRET_KEY=change-me

# Resend (transaktionaler E-Mail-Versand, siehe app/services/email.py).
# API-Key unter https://resend.com erstellen.
BODYCOMP_RESEND_API_KEY=change-me
BODYCOMP_EMAIL_FROM_ADDRESS=onboarding@resend.dev

# Basis-URL des Frontends, für Links in E-Mails (Bestätigung, Reset).
BODYCOMP_FRONTEND_BASE_URL=http://localhost:5173
