{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true
  },
  // Tests laufen unter Node (node --test, siehe npm run test), nicht im
  // Browser - sie gehören deshalb nicht in den DOM-orientierten
  // Type-Check der App und brauchen hier keine Node-Typen.
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
